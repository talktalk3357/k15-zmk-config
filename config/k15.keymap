#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp PG_UP &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp PG_DN &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp ENTER &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp LCTRL &kp LGUI &kp LALT &kp SPACE &mo 1
                &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC &kp HOME &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp END &kp H &kp J &kp K &kp L &kp SEMI &kp RBKT &kp PSCRN &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH &kp ENTER &kp BSPC &kp DEL &kp INT_RO &kp RCTRL
            >;
        };
        // Provisional: hold left Layer for F1..F12; other keys unchanged.
        function {
            display-name = "Fn";
            bindings = <
                &studio_unlock &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans &out OUT_USB &trans &trans &trans &trans &trans &trans &out OUT_BLE &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
        extra2 {
            display-name = "Extra 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
        extra3 {
            display-name = "Extra 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};

